# Copy this file to .env and fill in your own values:  cp .env.example .env
# Never commit .env: it is listed in .gitignore.

# --- Outlook (Microsoft Graph) ---
# Application (client) ID of your Azure app registration
CLIENT_ID=your-azure-application-client-id
# How often to check for new mail, in seconds (minimum 5)
POLL_SECONDS=15

# --- Jira ---
# true = only log the tickets that would be created (no Jira account needed)
# false = create real tickets (fill in the Jira settings below)
JIRA_DRY_RUN=true
JIRA_PROJECT_KEY=SUP
JIRA_ISSUE_TYPE=Task
JIRA_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token
